{
  "name": "langngheviet-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Clone giao dien Tap chi Lang nghe Viet Nam (langngheviet.com.vn) toi uu SEO voi Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "npx tsx --test tests/**/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma db push --force-reset && node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && node prisma/seed.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "next": "^15.5.25",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
