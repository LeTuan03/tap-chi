    <script>
        window.addEventListener('load', function() {
            // Hàm kiểm tra attr-video có chứa file MP3 hay không
            function checkAttrVideoForMP3() {
                var audioWrapper = document.querySelector('.audioWrapper');
                if (audioWrapper) {
                    var attrVideo = audioWrapper.getAttribute('attr-video') || '';
                    if (attrVideo.trim().toLowerCase().endsWith('.mp3')) {
                        return attrVideo; // Trả về URL mp3 trong attr-video
                    }
                }
                return null; // Không có mp3
            }

            // Thực hiện kiểm tra và xử lý sau khi load
            var mp3Url = checkAttrVideoForMP3();
            if (mp3Url) {
                // Ẩn .audioWrapper
                var audioWrapper = document.querySelector('.audioWrapper');
                if (audioWrapper) {
                    audioWrapper.style.display = 'none';
                }

                // Gán file mp3 vào #radio-detail
                var radioDetail = document.getElementById('radio-detail');
                if (radioDetail) {
                    radioDetail.style.display = 'block'; // Hiển thị nếu cần
                    radioDetail.innerHTML = '<audio style="width:100%;" controls src="' + mp3Url + '"></audio>';
                }
            }
        });
    </script>
